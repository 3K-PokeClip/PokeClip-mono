#!/usr/bin/env bash
#
# 운영 확인 스크립트 시험 전용 가짜 docker — 받은 argv 와 환경을 기록하고
# 상태 디렉터리의 파일로 답한다. 진짜 컨테이너는 띄우지 않는다.
#
# 받는 꼴(그 밖은 종료 2 — 스크립트가 다른 하위 명령 · 옵션을 쓰면 드러난다):
#   ps [-a] -q --no-trunc [--filter status=running | --filter health=healthy]
#      --filter label=com.docker.compose.project=<P>
#      --filter label=com.docker.compose.service=<S>
#        state/ps.<S> 의 「<id> <running|exited>」 줄에서 고른다. health 필터면
#        state/healthy.<S> 의 ID 줄을 낸다. P 가 PCBENCH_FAKE_PROJECT 와 다르면
#        빈 출력. state/ps.fail 이 있으면 종료 1.
#   compose -p <P> -f <F> up -d --no-deps --force-recreate <S>
#        재생성을 흉내 낸다 — 새 ID(pcbenchrecreated<n>)를 state/ps.<S> 의 단
#        하나의 running 줄로 두고, state/health.never 가 없으면
#        state/healthy.<S> 에도 둔다. 새 컨테이너의 저널
#        state/journal.c.<새 ID> 에 started 줄을 쓴다 — ip_limit 값은 만들 때
#        F 옆 ingest-auth.env 를 읽은 값이다(env_file 은 만들 때만 읽힌다).
#        PCBENCH_FAKE_STALE_ENV 가 있으면 반대 값을 쓴다(반영 안 됨 흉내).
#        state/journal.none 이 있으면 저널을 쓰지 않는다. state/compose.up.fail
#        이 있으면 종료 1, state/compose.up.hang 이 있으면 오래 잔다.
#   compose -p <P> -f <F> exec -T <S> /ingest-auth healthcheck
#        state/health.exec.fail 이 있으면 종료 1.
#   ps -a -q --no-trunc --filter label=com.pokeclip.loopback=<이름>
#        송출기 컨테이너(state/sender.<이름>)가 있으면 그 이름.
#   exec <id> sh -c <스크립트>
#        컨테이너 안 실행을 흉내 낸다 — 빈 환경에 state/ctr.<id>.env 의 줄
#        (컨테이너 환경)과 가짜 설정만 넣고 PATH 앞에 state/ctrbin(가짜 nc ·
#        감시 래퍼)을 둔 /bin/sh 로 스크립트를 돌린다. state/exec.hang 이 있으면
#        스크립트 대신 오래 잔다.
#   logs <id>
#        state/logs.<id>.out 을 표준 출력, state/logs.<id>.err 를 표준 오류로.
#        state/logs.fail 이 있으면 종료 1.
#   pull --quiet <이미지>
#        PCBENCH_FAKE_PULL_MODE=fail 이면 종료 1.
#   run … --name <이름> …
#        송출기를 흉내 낸다. PCBENCH_FAKE_RUN_MODE=fail 이면 곧바로 종료 125.
#        아니면 컨테이너(state/sender.<이름>)와 송출 중 표식(state/sending)을
#        만들고 TERM 을 받을 때까지(상한 60초) 돈다. TERM 을 받으면
#        state/run.terminated 를 남기고 끝난다 — 이때 컨테이너와 표식을
#        지우지만(--rm), PCBENCH_FAKE_RUN_MODE=stuck 이면 둘 다 남긴다(컨테이너가
#        TERM 에 안 끝나 클라이언트만 죽은 경우).
#   rm -f <이름>
#        컨테이너 · 표식을 지우고 state/rm.done 을 남긴다. 없으면 종료 1.
#        PCBENCH_FAKE_RM_MODE=fail 이면 지우지 않고 종료 1.
#
# 시험이 주는 값: PCBENCH_FAKE_LIB · PCBENCH_FAKE_LOG_DIR ·
# PCBENCH_FAKE_STATE_DIR · PCBENCH_FAKE_PROJECT · PCBENCH_FAKE_RUN_MODE ·
# PCBENCH_FAKE_PULL_MODE · PCBENCH_FAKE_RM_MODE · PCBENCH_FAKE_NC_MODE(exec
# 안의 가짜 nc 로 넘긴다).

# 아래 source= 경로를 이 파일 위치 기준으로 찾게 한다.
# shellcheck source-path=SCRIPTDIR

set -euo pipefail

# shellcheck source=record.sh
source "${PCBENCH_FAKE_LIB:?가짜 docker: PCBENCH_FAKE_LIB 없음}"

readonly STATE="${PCBENCH_FAKE_STATE_DIR:?PCBENCH_FAKE_STATE_DIR 없음}"

fake_sender=""
readonly PROJECT_LABEL='label=com.docker.compose.project='
readonly SERVICE_LABEL='label=com.docker.compose.service='
readonly SENDER_LABEL='label=com.pokeclip.loopback='

#######################################
# ps — 라벨 · 상태 필터에 맞는 id 를 낸다.
# Arguments:
#   ps 뒤의 argv.
#######################################
fake_ps() {
  local all=0 running=0 project="" service="" saw_q=0 saw_trunc=0 id status
  local sender="" healthy=0
  while (( $# > 0 )); do
    case "$1" in
      -a) all=1 ;;
      -q) saw_q=1 ;;
      --no-trunc) saw_trunc=1 ;;
      --filter)
        (( $# >= 2 )) || fake::unknown docker
        case "$2" in
          status=running) running=1 ;;
          health=healthy) healthy=1 ;;
          "${PROJECT_LABEL}"*) project="${2#"${PROJECT_LABEL}"}" ;;
          "${SERVICE_LABEL}"*) service="${2#"${SERVICE_LABEL}"}" ;;
          "${SENDER_LABEL}"*) sender="${2#"${SENDER_LABEL}"}" ;;
          *) fake::unknown docker ;;
        esac
        shift
        ;;
      *) fake::unknown docker ;;
    esac
    shift
  done
  if [[ -n "${sender}" ]]; then
    if (( !saw_q || !saw_trunc || !all || running )) \
      || [[ -n "${project}" || -n "${service}" ]]; then
      fake::unknown docker
    fi
    if [[ -e "${STATE}/sender.${sender}" ]]; then
      printf '%s\n' "${sender}"
    fi
    return 0
  fi
  if (( !saw_q || !saw_trunc )) || [[ -z "${project}" || -z "${service}" ]] \
    || (( healthy && (all || running) )) || (( !healthy && all == running ))
  then
    fake::unknown docker
  fi
  if [[ -e "${STATE}/ps.fail" ]]; then
    printf '가짜 docker: daemon 응답 없음(시험)\n' >&2
    exit 1
  fi
  [[ "${project}" == "${PCBENCH_FAKE_PROJECT:-}" ]] || return 0
  if (( healthy )); then
    [[ ! -f "${STATE}/healthy.${service}" ]] \
      || cat -- "${STATE}/healthy.${service}"
    return 0
  fi
  [[ -f "${STATE}/ps.${service}" ]] || return 0
  while read -r id status; do
    [[ -n "${id}" ]] || continue
    if (( running )) && [[ "${status}" != running ]]; then
      continue
    fi
    printf '%s\n' "${id}"
  done <"${STATE}/ps.${service}"
}

#######################################
# exec — 컨테이너 안 sh -c 를 흉내 낸다.
# Arguments:
#   exec 뒤의 argv.
#######################################
fake_exec() {
  local id env_file line ctr_env=()
  if (( $# != 4 )) || [[ "$2" != sh || "$3" != -c ]]; then
    fake::unknown docker
  fi
  id="$1"
  env_file="${STATE}/ctr.${id}.env"
  if [[ ! -f "${env_file}" ]]; then
    printf '가짜 docker: 컨테이너 %s 없음\n' "${id}" >&2
    exit 1
  fi
  if [[ -e "${STATE}/exec.hang" ]]; then
    exec sleep 60
  fi
  while IFS= read -r line; do
    [[ -n "${line}" ]] && ctr_env+=("${line}")
  done <"${env_file}"
  exec env -i "PATH=${STATE}/ctrbin:/usr/bin:/bin" "HOME=/" \
    "PCBENCH_FAKE_LIB=${PCBENCH_FAKE_LIB}" \
    "PCBENCH_FAKE_LOG_DIR=${PCBENCH_FAKE_LOG_DIR}" \
    "PCBENCH_FAKE_STATE_DIR=${STATE}" \
    "PCBENCH_FAKE_NC_MODE=${PCBENCH_FAKE_NC_MODE:-ok}" \
    ${ctr_env[@]+"${ctr_env[@]}"} /bin/sh -c "$4"
}

#######################################
# logs — 심어 둔 로그를 낸다.
# Arguments:
#   logs 뒤의 argv.
#######################################
fake_logs() {
  (( $# == 1 )) || fake::unknown docker
  if [[ -e "${STATE}/logs.fail" ]]; then
    printf '가짜 docker: logs 실패(시험)\n' >&2
    exit 1
  fi
  if [[ -f "${STATE}/logs.$1.out" ]]; then
    cat -- "${STATE}/logs.$1.out"
  fi
  if [[ -f "${STATE}/logs.$1.err" ]]; then
    cat -- "${STATE}/logs.$1.err" >&2
  fi
}

#######################################
# run — 송출기를 흉내 낸다.
# Arguments:
#   run 뒤의 argv.
#######################################
fake_run() {
  local deadline name=""
  while (( $# > 0 )); do
    if [[ "$1" == --name && $# -ge 2 ]]; then
      name="$2"
      break
    fi
    shift
  done
  [[ -n "${name}" ]] || fake::unknown docker
  if [[ "${PCBENCH_FAKE_RUN_MODE:-ok}" == fail ]]; then
    printf '가짜 docker: 컨테이너 시작 실패(시험)\n' >&2
    exit 125
  fi
  fake_sender="${name}"
  trap fake_run_term TERM
  : >"${STATE}/sender.${name}"
  : >"${STATE}/sending"
  deadline=$((SECONDS + 60))
  while (( SECONDS < deadline )); do
    sleep 0.2
  done
  rm -f -- "${STATE}/sending" "${STATE}/sender.${name}"
}

#######################################
# run 이 TERM 을 받았을 때 — stuck 이 아니면 컨테이너 · 표식을 지운다.
# Globals:
#   fake_sender
#######################################
fake_run_term() {
  : >"${STATE}/run.terminated"
  if [[ "${PCBENCH_FAKE_RUN_MODE:-ok}" != stuck ]]; then
    rm -f -- "${STATE}/sending" "${STATE}/sender.${fake_sender}"
  fi
  exit 143
}

#######################################
# rm -f — 송출기 컨테이너를 지운다.
# Arguments:
#   rm 뒤의 argv.
#######################################
fake_rm() {
  if (( $# != 2 )) || [[ "$1" != -f ]]; then
    fake::unknown docker
  fi
  if [[ "${PCBENCH_FAKE_RM_MODE:-ok}" == fail ]]; then
    printf '가짜 docker: rm 실패(시험)\n' >&2
    exit 1
  fi
  : >"${STATE}/rm.done"
  if [[ ! -e "${STATE}/sender.$2" ]]; then
    printf '가짜 docker: 그런 컨테이너 없음\n' >&2
    exit 1
  fi
  rm -f -- "${STATE}/sender.$2" "${STATE}/sending"
}

#######################################
# pull — 이미지 받기를 흉내 낸다.
# Arguments:
#   pull 뒤의 argv.
#######################################
fake_pull() {
  if (( $# != 2 )) || [[ "$1" != --quiet ]]; then
    fake::unknown docker
  fi
  if [[ "${PCBENCH_FAKE_PULL_MODE:-ok}" == fail ]]; then
    printf '가짜 docker: pull 실패(시험)\n' >&2
    exit 1
  fi
}

#######################################
# compose up — 재생성을 흉내 낸다.
# Arguments:
#   compose 파일, 서비스.
#######################################
fake_recreate() {
  local file="$1" service="$2" n=1 id value
  if [[ -e "${STATE}/compose.up.hang" ]]; then
    exec sleep 60
  fi
  if [[ -e "${STATE}/compose.up.fail" ]]; then
    printf '가짜 docker: compose up 실패(시험)\n' >&2
    exit 1
  fi
  while [[ -e "${STATE}/journal.c.pcbenchrecreated${n}" \
    || -e "${STATE}/made.pcbenchrecreated${n}" ]]; do
    n=$((n + 1))
  done
  id="pcbenchrecreated${n}"
  : >"${STATE}/made.${id}"
  printf '%s running\n' "${id}" >"${STATE}/ps.${service}"
  rm -f -- "${STATE}/healthy.${service}"
  [[ -e "${STATE}/health.never" ]] \
    || printf '%s\n' "${id}" >"${STATE}/healthy.${service}"
  [[ ! -e "${STATE}/journal.none" ]] || return 0
  value="$(sed -n 's/^INGEST_AUTH_IP_LIMIT=//p' \
    "$(dirname -- "${file}")/ingest-auth.env" 2>/dev/null)" || value=""
  if [[ -n "${PCBENCH_FAKE_STALE_ENV:-}" ]]; then
    [[ "${value}" == on ]] && value=off || value=on
  fi
  printf '{"level":"INFO","msg":"ingestauth_started","ip_limit":"%s",%s}\n' \
    "${value}" '"ip_limit_burst":30' >"${STATE}/journal.c.${id}"
}

#######################################
# compose — up(재생성) · exec(healthcheck) 두 꼴만 받는다.
# Arguments:
#   compose 뒤의 argv.
#######################################
fake_compose() {
  if (( $# < 5 )) || [[ "$1" != -p || "$3" != -f ]]; then
    fake::unknown docker
  fi
  local file="$4"
  shift 4
  if [[ "$*" == 'up -d --no-deps --force-recreate ingest-auth' ]]; then
    fake_recreate "${file}" ingest-auth
  elif [[ "$*" == 'exec -T ingest-auth /ingest-auth healthcheck' ]]; then
    if [[ -e "${STATE}/health.exec.fail" ]]; then
      printf 'ingest-auth: /healthz 의 답이 200 이 아니다 — HTTP 503\n' >&2
      exit 1
    fi
  else
    fake::unknown docker
  fi
}

main() {
  fake::record docker "$@"
  (( $# > 0 )) || fake::unknown docker
  local sub="$1"
  shift
  case "${sub}" in
    ps) fake_ps "$@" ;;
    exec) fake_exec "$@" ;;
    logs) fake_logs "$@" ;;
    run) fake_run "$@" ;;
    rm) fake_rm "$@" ;;
    pull) fake_pull "$@" ;;
    compose) fake_compose "$@" ;;
    *) fake::unknown docker ;;
  esac
}

main "$@"
