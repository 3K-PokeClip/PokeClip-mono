#!/usr/bin/env bash
#
# 가짜 aws — 시작 스크립트의 비밀 조회(Secrets Manager get-secret-value — CDN
# 비밀 · 응답기 모드의 4C 토큰)와 거부 목록 조회(SSM get-parameter)만 흉내 낸다.
# 시험 전용이고, 돌려주는 값은 실제 비밀이 아닌 고정 시험 문자열이다. 비밀 조회는
# --secret-id 로 값을 고른다 — 4C 토큰 ARN(FAKE_RESOLVE_ARN)이면 4C 토큰 갈래,
# 그 밖은 CDN 비밀 갈래다.
# 계약 시험(실물 compose) · start_test · 유닛 재기동 시험이 PATH 앞에 이 디렉터리를
# 둔다.
#
# 시험이 주는 값(시작 스크립트는 읽지 않는다):
#   PCBENCH_FAKE_AWS_MODE  ok(기본) · fail(종료 254) · empty(빈 값) ·
#                          hang(모드 파일 옆에 <모드 파일>.hang 표식을 남기고
#                          HANG_SECONDS 초 머문 뒤 ok 와 같은 값 — 모드 파일로만
#                          쓴다. 유닛 시험의 기동 중 정지) ·
#                          none(SecretString 이 없을 때 CLI 가 내는 None) ·
#                          special(특수 문자가 든 값) · multiline(가운데
#                          줄바꿈) · trailing(끝 줄바꿈 — 출력 끝이 줄바꿈 둘) ·
#                          value(PCBENCH_FAKE_AWS_VALUE_FILE 파일 내용을 바이트
#                          그대로(NUL 포함) 낸 뒤 줄바꿈 하나 — 값을 환경에 두면
#                          자식 기록에 섞이므로 파일로 받는다. 값 파일은 끝
#                          줄바꿈 없이 쓴다)
#   PCBENCH_FAKE_AWS_MODE_FILE  있으면 이 파일의 첫 줄이 모드다(위 변수보다
#                          먼저 본다). 부를 때마다 읽으므로 띄운 유닛을 건드리지
#                          않고 모드를 바꿀 수 있다(유닛 시험 ④). 파일이 없으면
#                          종료 2.
#   PCBENCH_FAKE_AWS_RESOLVE_MODE
#                          4C 토큰 갈래의 모드 — ok(기본) · fail · empty · none ·
#                          value(PCBENCH_FAKE_AWS_RESOLVE_VALUE_FILE 파일 내용을
#                          바이트 그대로 낸 뒤 줄바꿈 하나).
#   PCBENCH_FAKE_AWS_SSM_MODE
#                          거부 목록 조회의 모드 — ok(기본 · 머리 줄 + 토큰 한
#                          줄) · headeronly(머리 줄만) · notfound(종료 254) ·
#                          blank(공백뿐) · noheader(머리 줄 없이 토큰 줄) ·
#                          oversize(64 KiB 초과) · nul(머리 줄 뒤에 NUL) ·
#                          value(PCBENCH_FAKE_AWS_SSM_VALUE_FILE 파일 내용 뒤
#                          줄바꿈 하나).
#   PCBENCH_FAKE_LOG_DIR   있으면 argv 를 aws.<n>.argv 에 한 줄에 하나씩 적는다.
#
# 모르는 호출 꼴이면 종료 2 — 시작 스크립트가 argv 를 바꾸면 드러난다.

set -euo pipefail

readonly FAKE_SECRET='pcbench-edge-proxy-fake-cdn-secret'
# 4C 토큰 ARN(값이 아니다)과 그 갈래가 돌려주는 가짜 토큰.
readonly FAKE_RESOLVE_ARN='pcbench-ingest-auth-fake-resolve-arn'
readonly FAKE_RESOLVE_TOKEN='pcbench-ingest-auth-fake-resolve-token'
readonly DENY_HEADER='# pokeclip deny-tokens v1'
readonly FAKE_DENY_TOKEN='pcbench-deny-token-1'
# 거부 목록 크기 상한(바이트) — oversize 모드가 넘긴다.
readonly DENY_MAX_BYTES=65536
# hang 모드가 머무는 시간(초) — 유닛 ExecStop 의 주 프로세스 대기 상한(30초)보다
# 짧다.
readonly HANG_SECONDS=10
# sed · 패턴 치환에서 뜻이 있는 글자를 모았다(& \ $ / * 따옴표).
# shellcheck disable=SC2016 # 펼치지 않는 것이 뜻이다.
readonly SPECIAL_SECRET='pcbench&edge\proxy$fake/*"cdn'"'"'secret'

#######################################
# argv 를 기록한다(로그 디렉터리가 있을 때만).
# Globals:
#   PCBENCH_FAKE_LOG_DIR
# Arguments:
#   받은 argv.
#######################################
record_argv() {
  local dir="${PCBENCH_FAKE_LOG_DIR:-}" n
  [[ -n "${dir}" ]] || return 0
  n=1
  while [[ -e "${dir}/aws.${n}.argv" ]]; do
    n=$((n + 1))
  done
  printf '%s\n' "$@" >"${dir}/aws.${n}.argv"
}

#######################################
# 이번 호출의 모드를 낸다 — 모드 파일이 있으면 그 첫 줄, 없으면 환경 값.
# Globals:
#   PCBENCH_FAKE_AWS_MODE_FILE, PCBENCH_FAKE_AWS_MODE
#######################################
current_mode() {
  local file="${PCBENCH_FAKE_AWS_MODE_FILE:-}" mode
  if [[ -z "${file}" ]]; then
    printf '%s' "${PCBENCH_FAKE_AWS_MODE:-ok}"
    return 0
  fi
  if [[ ! -f "${file}" ]] || ! IFS= read -r mode <"${file}"; then
    printf '가짜 aws: 모드 파일을 읽지 못함\n' >&2
    return 1
  fi
  printf '%s' "${mode}"
}

#######################################
# CDN 비밀 갈래 — 모드대로 값을 낸다.
# Arguments:
#   모드.
#######################################
cdn_secret() {
  case "$1" in
    ok) printf '%s\n' "${FAKE_SECRET}" ;;
    special) printf '%s\n' "${SPECIAL_SECRET}" ;;
    multiline) printf '%s\nlogLevel: debug\n' "${FAKE_SECRET}" ;;
    trailing) printf '%s\n\n' "${FAKE_SECRET}" ;;
    value)
      cat -- "${PCBENCH_FAKE_AWS_VALUE_FILE:?가짜 aws: 값 파일 없음}"
      printf '\n'
      ;;
    hang)
      : >"${PCBENCH_FAKE_AWS_MODE_FILE:?가짜 aws: hang 은 모드 파일로만}.hang"
      sleep "${HANG_SECONDS}"
      printf '%s\n' "${FAKE_SECRET}"
      ;;
    empty) printf '\n' ;;
    none) printf 'None\n' ;;
    fail)
      printf '가짜 aws: AccessDeniedException(시험)\n' >&2
      exit 254
      ;;
    *)
      printf '가짜 aws: 모르는 모드\n' >&2
      exit 2
      ;;
  esac
}

#######################################
# 4C 토큰 갈래 — PCBENCH_FAKE_AWS_RESOLVE_MODE 대로 값을 낸다.
# Globals:
#   PCBENCH_FAKE_AWS_RESOLVE_MODE, PCBENCH_FAKE_AWS_RESOLVE_VALUE_FILE
#######################################
resolve_token() {
  case "${PCBENCH_FAKE_AWS_RESOLVE_MODE:-ok}" in
    ok) printf '%s\n' "${FAKE_RESOLVE_TOKEN}" ;;
    value)
      cat -- "${PCBENCH_FAKE_AWS_RESOLVE_VALUE_FILE:?가짜 aws: 값 파일 없음}"
      printf '\n'
      ;;
    empty) printf '\n' ;;
    none) printf 'None\n' ;;
    fail)
      printf '가짜 aws: AccessDeniedException(시험)\n' >&2
      exit 254
      ;;
    *)
      printf '가짜 aws: 모르는 4C 모드\n' >&2
      exit 2
      ;;
  esac
}

#######################################
# 거부 목록 갈래 — PCBENCH_FAKE_AWS_SSM_MODE 대로 파라미터 값을 낸다(text 출력
# 처럼 끝에 줄바꿈 하나).
# Globals:
#   PCBENCH_FAKE_AWS_SSM_MODE, PCBENCH_FAKE_AWS_SSM_VALUE_FILE
#######################################
deny_param() {
  local i
  case "${PCBENCH_FAKE_AWS_SSM_MODE:-ok}" in
    ok) printf '%s\n%s\n' "${DENY_HEADER}" "${FAKE_DENY_TOKEN}" ;;
    headeronly) printf '%s\n' "${DENY_HEADER}" ;;
    blank) printf ' \t \n\n' ;;
    noheader) printf '%s\n' "${FAKE_DENY_TOKEN}" ;;
    oversize)
      printf '%s\n' "${DENY_HEADER}"
      for (( i = 0; i * 64 <= DENY_MAX_BYTES; i++ )); do
        printf '%063d\n' "${i}"
      done
      ;;
    nul) printf '%s\n%s\000\n' "${DENY_HEADER}" "${FAKE_DENY_TOKEN}" ;;
    value)
      cat -- "${PCBENCH_FAKE_AWS_SSM_VALUE_FILE:?가짜 aws: 값 파일 없음}"
      printf '\n'
      ;;
    notfound)
      printf '가짜 aws: ParameterNotFound(시험)\n' >&2
      exit 254
      ;;
    *)
      printf '가짜 aws: 모르는 SSM 모드\n' >&2
      exit 2
      ;;
  esac
}

main() {
  local mode
  record_argv "$@"
  if (( $# == 8 )) && [[ "$1 $2 $3" == 'ssm get-parameter --name' \
    && -n "$4" && "$5 $6 $7 $8" == '--query Parameter.Value --output text' ]]
  then
    deny_param
    return
  fi
  if (( $# != 8 )) \
    || [[ "$1 $2 $3" != 'secretsmanager get-secret-value --secret-id' \
    || -z "$4" || "$5 $6 $7 $8" != '--query SecretString --output text' ]]
  then
    printf '가짜 aws: 모르는 호출\n' >&2
    exit 2
  fi
  if [[ "$4" == "${FAKE_RESOLVE_ARN}" ]]; then
    resolve_token
    return
  fi
  mode="$(current_mode)" || exit 2
  cdn_secret "${mode}"
}

main "$@"
