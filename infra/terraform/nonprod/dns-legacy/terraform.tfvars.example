# terraform.tfvars 로 복사해 실제 값을 넣는다. terraform.tfvars 는 추적하지 않는다.
# 값은 운영 O1 전 읽기 조사(옛 존 레코드 목록 · NS TTL 현재 값) 그대로다.
zone_id      = "<ZONE_ID_LEGACY>"
zone_comment = "<ZONE_COMMENT_LEGACY>"
zone_tags    = {}

# 숫자다. 현재 NS TTL 을 따옴표 없이 넣는다(예시 자리표시자는 문자열).
ns_ttl = "<NS_TTL_CURRENT>"

# apex NS · SOA 는 넣지 않는다. 키는 임의 이름.
records = {
  "<RECORD_KEY>" = {
    name    = "<RECORD_NAME>"
    type    = "<RECORD_TYPE>"
    ttl     = "<RECORD_TTL>"
    records = ["<RECORD_VALUE>"]
  }
}
