# terraform.tfvars 로 복사해 실제 값을 넣는다. terraform.tfvars 는 추적하지 않는다.
# 값은 운영 O1 전 읽기 조사(옛 존 레코드 목록 · NS TTL 현재 값) 그대로다.
#
# O1 전 읽기 조사로 확인할 가정(다르면 값만이 아니라 선언을 고친다):
# 1. apex NS · SOA 를 뺀 레코드가 모두 단순 레코드다(별칭 · 라우팅 정책
#    set_identifier · 헬스 체크 없음). list-resource-record-sets 로 대조한다.
# 2. 존 comment · 태그 · apex NS TTL 현재 값.
# 첫 plan 이 「import N · 생성 0 · 수정 0 · 삭제 0」이 아니면 apply 하지 않는다.
zone_id      = "<ZONE_ID_LEGACY>"
zone_comment = "<ZONE_COMMENT_LEGACY>"
zone_tags    = {}

# 숫자다. 현재 NS TTL 을 따옴표 없이 넣는다(예시 자리표시자는 문자열).
ns_ttl = "<NS_TTL_CURRENT>"

# apex NS · SOA 는 넣지 않는다. 키는 임의 이름.
records = {
  "<RECORD_KEY>" = {
    name    = "<RECORD_NAME>"
    type    = "<RECORD_TYPE>"
    ttl     = "<RECORD_TTL>"
    records = ["<RECORD_VALUE>"]
  }
}
