#!/bin/bash
#
# put_secret_test.sh 의 가짜 aws. AWS 에 접속하지 않는다.
#
# 받은 인자(한 줄에 하나) · 환경(시험이 보는 값만 — record_env) · 받은 값 ·
# 받은 값이 든 환경 변수의 이름(env-hits — record_env_hits)을 FAKE_AWS_DIR 에
# 적고, 부를 때마다 calls 에 한 줄을 더한다. 시험은 PATH 에 fakebin 만 두므로
# 셸 내장만 쓴다.
#
# 값을 받는 방식은 aws-cli 2.36.7 의 실제 거동을 따른다(2026-10-17 실측):
#   --secret-string file:///dev/stdin  표준 입력을 한 번 읽는다(정상 경로).
#   --cli-input-json file://<경로>     CLI 처럼 그 경로를 두 번 읽는다. 파이프는
#                                      둘째 읽기가 비어 ParamValidation(252).
#   그 밖의 값 넘기기                  violation 에 이유를 적고 실패한다(값이
#                                      인자 · 다른 파일로 지나감 — 시험이 잡음).
# 오류 꼴은 2.36.7 의 「aws: [ERROR]: …」 다. denied · denied-short · error 는
# 일부러 받은 값을 되울린다 — 원문이 값을 품는 최악의 경우에도 스크립트가 원문을
# 내보내지 않는지 보려고. ARN 의 계정 ID 는 AWS 문서의 예시 값이다.
#
# FAKE_AWS_MODE:
#   ok            성공 응답(ARN · Name · VersionId), 종료 0
#   no-version    VersionId 없는 응답, 종료 0
#   denied        AccessDeniedException(SCP 명시 거부), 종료 254
#   denied-short  AccessDenied(Exception 없는 꼴), 종료 254
#   error         ResourceNotFoundException, 종료 254
#   endpoint      네트워크 단계 실패(Read timeout on endpoint URL), 종료 255
#   unparsed      오류 코드 · endpoint URL 이 없는 실패(SSL 검증), 종료 255
#
# aws configure get cli_history --no-cli-auto-prompt(CLI 기록 검사)는 값을 받지
# 않는 호출이라 calls · argv 에 적지 않고, 받은 인자를 한 줄로 이어
# history-calls 에 더한다. 표준 입력에 한 바이트라도 있으면 violation 에 적고
# 실패한다(auto-prompt 가 표준 입력의 값을 키 입력으로 읽지 않게 스크립트가
# </dev/null 로 부르는지). 그 뒤 FAKE_AWS_CLI_HISTORY 로 답한다
# (precheck/tests/fakebin/aws 와 같은 뜻): 비면 값 없음(빈 출력 · 종료 1 —
# 진짜 CLI), fail 이면 설정 읽기 실패(종료 255), 그 밖이면 그 값.

set -uo pipefail
# 물려받은 allexport · 추적 · verbose 를 끈다(SHELLOPTS). allexport 가 켜져
# 있으면 가짜 aws 자신의 변수도 export 되어 record_env_hits 가 그 이름을 잡고,
# 추적이 켜져 있으면 대조 줄의 추적이 export 변수 값(호출자의 토큰 등)을 표준
# 오류로 낸다.
set +o allexport +o xtrace +o verbose

# 가짜 aws 가 만드는 전역 이름은 모두 STUB_ · stub_ 로 시작한다 — 물려받은
# 같은 이름의 값을 record_env_hits 의 대조 전에 덮지 않게.
readonly STUB_ACCOUNT='123456789012'
STUB_ARN="arn:aws:secretsmanager:ap-northeast-2:${STUB_ACCOUNT}:secret"
STUB_ARN+=':x-AbCdEf'
readonly STUB_ARN
readonly STUB_USER_ARN="arn:aws:iam::${STUB_ACCOUNT}:user/example"
readonly STUB_ENDPOINT='https://secretsmanager.ap-northeast-2.amazonaws.com/'

stub_value=""

#######################################
# 값 넘기기 규칙을 어긴 호출을 적고 끝낸다. 이유에 값을 넣지 않는다.
# Arguments:
#   이유.
#######################################
violation() {
  printf '%s\n' "$*" >>"${FAKE_AWS_DIR}/violation"
  printf 'fake aws: %s\n' "$*" >&2
  exit 99
}

#######################################
# 파일(/dev/stdin 포함)을 끝까지 읽어 stub_value 에 담는다. 셸 내장만 쓴다 —
# read -d '' 는 파일 끝에서 1 을 내지만 읽은 내용은 담긴다.
# Globals:
#   stub_value
# Arguments:
#   경로.
#######################################
read_all() {
  stub_value=""
  IFS= read -r -d '' stub_value <"$1"
  return 0
}

#######################################
# 인자에서 값을 받는다. 받은 값은 FAKE_AWS_DIR/stdin 에 적는다.
# Globals:
#   stub_value
# Arguments:
#   aws 가 받은 인자들.
#######################################
receive_value() {
  local secret_string="" cli_input="" path second
  local has_secret_string=false has_cli_input=false
  while (($# > 0)); do
    case "$1" in
      --secret-string)
        has_secret_string=true
        secret_string="${2-}"
        shift
        ;;
      --cli-input-json)
        has_cli_input=true
        cli_input="${2-}"
        shift
        ;;
      --secret-string=* | --cli-input-json=*)
        violation "값 인자를 = 꼴로 받음"
        ;;
    esac
    shift
  done
  if [[ "${has_cli_input}" == true ]]; then
    path="${cli_input#file://}"
    [[ "${path}" != "${cli_input}" ]] ||
      violation "--cli-input-json 이 file:// 이 아님(값이 인자로 옴)"
    read_all "${path}"
    printf '%s' "${stub_value}" >"${FAKE_AWS_DIR}/stdin"
    second=""
    IFS= read -r -d '' second <"${path}"
    if [[ -z "${second}" ]]; then
      printf '\naws: [ERROR]: An error occurred (ParamValidation): %s\n' \
        "Error parsing parameter 'cli-input-json': Invalid JSON received." >&2
      exit 252
    fi
    violation "--cli-input-json 은 이 시험이 받지 않음"
  fi
  [[ "${has_secret_string}" == true ]] || violation "--secret-string 이 없음"
  case "${secret_string}" in
    file:///dev/stdin)
      read_all /dev/stdin
      printf '%s' "${stub_value}" >"${FAKE_AWS_DIR}/stdin"
      ;;
    file://*)
      read_all "${secret_string#file://}"
      printf '%s' "${stub_value}" >"${FAKE_AWS_DIR}/stdin"
      violation "--secret-string 이 /dev/stdin 이 아닌 파일"
      ;;
    *) violation "--secret-string 이 file:// 이 아님(값이 인자로 옴)" ;;
  esac
}

#######################################
# 받은 환경 중 시험이 값을 보는 이름만 「이름=값」 줄로 FAKE_AWS_DIR/env 에
# 적는다: AWS_PAGER · AWS_CONFIG_FILE · AWS_SHARED_CREDENTIALS_FILE ·
# AWS_EC2_METADATA_DISABLED · HOME · TMPDIR · SHELL · LC_ALL · PATH ·
# SHELLOPTS. 그 밖의 AWS_ 는 이름만 적는다(시험이 이름을 대조). 호출자 셸의
# 다른 환경(살아 있는 토큰 변수 등)은 사례 파일에 옮기지 않는다. 값이 환경으로
# 새는지는 이름과 상관없이 record_env_hits 가 보므로, 스크립트의 값 변수
# (secret_value)도 여기 적지 않는다.
# Globals:
#   FAKE_AWS_DIR
#######################################
record_env() {
  local name
  for name in $(compgen -e); do
    case "${name}" in
      AWS_PAGER | AWS_CONFIG_FILE | AWS_SHARED_CREDENTIALS_FILE | \
        AWS_EC2_METADATA_DISABLED | HOME | TMPDIR | SHELL | LC_ALL | PATH | \
        SHELLOPTS)
        printf '%s=%s\n' "${name}" "${!name-}"
        ;;
      AWS_*) printf '%s\n' "${name}" ;;
    esac
  done >"${FAKE_AWS_DIR}/env"
}

#######################################
# 받은 값이나 시험의 표지가 든 export 변수의 이름만 FAKE_AWS_DIR/env-hits 에 한
# 줄씩 적는다. 대조는 메모리 안에서만(부분 문자열 포함) 하고, 값은 어떤
# 파일에도 쓰지 않는다.
#   값 전체: 끝 줄바꿈을 뗀 값 — 명령 치환으로 옮긴 사본도 잡게. 뗀 값이
#     비면 대조하지 않는다(빈 값 · 공백만은 스크립트가 aws 전에 거부한다).
#   표지: 시험이 FAKE_AWS_DIR/markers 에 한 줄에 하나 적은 값의 일부. 앞
#     토막 · 끝 한 글자 뗌 · JSON 이스케이프 같은 일부 · 변형 사본도 표지를
#     통째로 품으면 잡는다. 표지를 품지 않는 조각(예: PEM 머리 줄만)은 못
#     잡는다. 표지는 환경 변수로 받지 않는다 — 그 변수 자신이 걸린다.
# 볼 수 없는 이름(사각): 가짜 aws 가 만드는 STUB_ · stub_ 이름과, bash 가
# 시작할 때 자기 값으로 다시 쓰는 이름(SHELLOPTS · SHLVL · PWD 등).
# Globals:
#   FAKE_AWS_DIR, stub_value
#######################################
record_env_hits() {
  local stub_needle="${stub_value}" stub_name stub_marker
  local -a stub_markers=()
  while [[ "${stub_needle}" == *$'\n' ]]; do
    stub_needle="${stub_needle%$'\n'}"
  done
  [[ -z "${stub_needle}" ]] || stub_markers=("${stub_needle}")
  if [[ -f "${FAKE_AWS_DIR}/markers" ]]; then
    while IFS= read -r stub_marker; do
      [[ -z "${stub_marker}" ]] || stub_markers+=("${stub_marker}")
    done <"${FAKE_AWS_DIR}/markers"
  fi
  ((${#stub_markers[@]} > 0)) || return 0
  for stub_name in $(compgen -e); do
    for stub_marker in "${stub_markers[@]}"; do
      if [[ "${!stub_name-}" == *"${stub_marker}"* ]]; then
        printf '%s\n' "${stub_name}" >>"${FAKE_AWS_DIR}/env-hits"
        break
      fi
    done
  done
}

#######################################
# FAKE_AWS_MODE 에 맞는 응답(표준 출력 · 표준 오류)을 내고, 실패 모드면 그
# 종료 코드로 끝낸다.
# Globals:
#   FAKE_AWS_MODE, stub_value
# Outputs:
#   aws-cli 2.36.7 꼴의 응답(표준 출력) · 오류 원문(표준 오류).
#######################################
respond() {
  local code
  case "${FAKE_AWS_MODE:-ok}" in
    ok)
      printf '{\n    "ARN": "%s",\n    "Name": "example",\n' "${STUB_ARN}"
      printf '    "VersionId": "a1b2c3d4-5678-90ab-cdef-EXAMPLE11111",\n'
      printf '    "VersionStages": [\n        "AWSCURRENT"\n    ]\n}\n'
      ;;
    no-version)
      printf '{\n    "ARN": "%s",\n    "Name": "example"\n}\n' "${STUB_ARN}"
      ;;
    denied | denied-short)
      code=AccessDeniedException
      [[ "${FAKE_AWS_MODE}" == denied ]] || code=AccessDenied
      printf '\naws: [ERROR]: An error occurred (%s) when calling the %s' \
        "${code}" "PutSecretValue operation: User: ${STUB_USER_ARN} is not" >&2
      printf ' authorized to perform: %s on resource: %s %s\n' \
        secretsmanager:PutSecretValue "${STUB_ARN}" \
        "with an explicit deny in a service control policy" >&2
      printf 'received: %s\n' "${stub_value}" >&2
      exit 254
      ;;
    error)
      printf '\naws: [ERROR]: An error occurred (%s) when calling %s\n' \
        ResourceNotFoundException \
        "the PutSecretValue operation: ${STUB_ARN} not found" >&2
      printf 'received: %s\n' "${stub_value}" >&2
      exit 254
      ;;
    endpoint)
      printf '\naws: [ERROR]: Read timeout on endpoint URL: "%s"\n' \
        "${STUB_ENDPOINT}" >&2
      exit 255
      ;;
    unparsed)
      printf '\naws: [ERROR]: SSL validation failed for %s %s\n' \
        "${STUB_ENDPOINT}" \
        "[SSL: CERTIFICATE_VERIFY_FAILED] certificate verify failed" >&2
      exit 255
      ;;
    *)
      printf 'fake aws: 모르는 FAKE_AWS_MODE: %s\n' "${FAKE_AWS_MODE}" >&2
      exit 99
      ;;
  esac
}

#######################################
# aws configure get cli_history 에 답하고 끝낸다(머리 주석).
# Globals:
#   FAKE_AWS_DIR, FAKE_AWS_CLI_HISTORY
# Arguments:
#   aws 가 받은 인자들.
#######################################
configure_get() {
  local stub_stdin=""
  printf '%s\n' "$*" >>"${FAKE_AWS_DIR}/history-calls"
  IFS= read -r -d '' stub_stdin
  [[ -z "${stub_stdin}" ]] ||
    violation "configure get 의 표준 입력이 비어 있지 않음(</dev/null 아님)"
  if [[ "$*" != 'configure get cli_history --no-cli-auto-prompt' ]]; then
    printf 'fake aws: 모르는 설정 조회: %s\n' "$*" >&2
    exit 99
  fi
  case "${FAKE_AWS_CLI_HISTORY:-}" in
    '') exit 1 ;;
    fail)
      printf '\nThe config profile (example) could not be found\n' >&2
      exit 255
      ;;
    *)
      printf '%s\n' "${FAKE_AWS_CLI_HISTORY}"
      exit 0
      ;;
  esac
}

main() {
  if [[ -z "${FAKE_AWS_DIR:-}" || ! -d "${FAKE_AWS_DIR}" ]]; then
    printf '%s\n' "fake aws: FAKE_AWS_DIR 가 없음" >&2
    exit 99
  fi
  [[ "${1-}" != configure ]] || configure_get "$@"
  printf 'call\n' >>"${FAKE_AWS_DIR}/calls"
  printf '%s\n' "$@" >"${FAKE_AWS_DIR}/argv"
  record_env
  receive_value "$@"
  record_env_hits
  respond
}

main "$@"
