# terraform.tfvars 로 복사해 실제 값을 넣는다. terraform.tfvars 는 추적하지 않는다.

# clip 과 같은 커밋에서 빌드해 푸시한 일꾼 이미지의 다이제스트
# (runbooks/prod-artifacts.md). 태그가 아니라 sha256:<64자리> 다.
image_digests = {
  render = "sha256:<RENDER_DIGEST>"
  upload = "sha256:<UPLOAD_DIGEST>"
}

# 기본값 — kty 확정(2026-11-04). 출시 뒤 실측으로 조정한다. 키는 render ·
# upload 정확히 둘이다.
# workers = {
#   render = { cpu = 2048, memory = 4096, ephemeral_storage_gib = 40 }
#   upload = { cpu = 512, memory = 1024 }
# }
