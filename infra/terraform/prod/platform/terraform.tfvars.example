# terraform.tfvars 로 복사해 실제 값을 넣는다. terraform.tfvars 는 추적하지 않는다.

# O7c 에서 푸시한 이미지의 다이제스트(runbooks/prod-artifacts.md). 태그가 아니라
# sha256:<64자리> 다. next 이미지는 빌드 인자 AUTH_API_URL ·
# CLIP_API_URL 을 Cloud Map 이름으로 빌드한 것이어야 한다(README 「Next 이미지
# 빌드 인자」).
image_digests = {
  next = "sha256:<NEXT_DIGEST>"
  auth = "sha256:<AUTH_DIGEST>"
  clip = "sha256:<CLIP_DIGEST>"
}

# Media 상자 nginx 듣기 포트 · 헬스 경로의 정본 — 대상 그룹이 쓰고, 출력으로
# 내보내 prod/media 가 읽는다. 1024 이상 · 서로 다름 · 8080 · 8081 · 8888 · 9996 · 9997 이 아님.
proxy_ports = {
  live     = <PROXY_LIVE_PORT>
  playback = <PROXY_PLAYBACK_PORT>
  control  = <PROXY_CONTROL_PORT>
  health   = <PROXY_HEALTH_PORT>
}
media_health_path = "<MEDIA_HEALTH_PATH>"

# SRT 송출을 허용할 팀 IP(IPv4 CIDR). 0.0.0.0/0 으로 넓히는 것은 별도
# 승인 지점이다(설계 4-6 — S1 게이트 + 응답기 선행).
ingest_allowed_cidrs = ["<TEAM_IP_CIDR>"]

# /16 보다 넓은 출처(0.0.0.0/0 등)는 이 값이 true 일 때만 받는다. S1 게이트 ·
# 응답기(M15) 반영 뒤 8a 단계에서만 true 로 바꾼다.
# ingest_public_approved = false

# auth · clip 이미지 안 RDS CA 번들 경로(3번 이미지 — app_db_auth = iam 이면
# 필수). O7d 전에 POK-407(IAM DB 인증 코드)이 머지되지 않았으면 아래 줄을
# 켜고 이 값은 지운다 — 런타임이 DB 비밀번호 그릇을 준다.
# app_db_auth = "password"
postgres_sslrootcert = "<RDS_CA_BUNDLE_PATH_IN_IMAGE>"

# auth 톰캣이 X-Forwarded-* 를 믿을 대역(정규식). 3번(POK-316)이 값을 정하면
# 채운다. 비워 두면 톰캣 기본 대역(사설망 · 루프백)이다.
# auth_internal_proxies = "<INTERNAL_PROXIES_REGEX>"
