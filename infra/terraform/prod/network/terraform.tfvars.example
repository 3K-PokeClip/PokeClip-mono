# terraform.tfvars 로 복사해 실제 값을 넣는다. terraform.tfvars 는 추적하지 않는다.
# cidr 는 dev 상자 VPC CIDR 과 겹치지 않는 값으로 고른다 — O7a 선행 0 에서
# dev VPC CIDR 을 읽어 확인한다(설계 2-3 「네트워크」). /16 부터 /25 까지의
# 네트워크 주소(서브넷이 ALB 최소인 /27 이상이 되게).
cidr = "<PROD_VPC_CIDR>"

# 서로 다른 AZ 두 개(순서 = 서브넷 CIDR · 출력 목록 순서).
azs = ["<AZ_1>", "<AZ_2>"]

# azs 중 하나. NAT 는 media_az 와 같은 AZ 에 두기를 권한다 — Media 상자의
# 나가는 트래픽이 AZ 를 건너지 않는다.
media_az = "<MEDIA_AZ>"
nat_az   = "<MEDIA_AZ>"
