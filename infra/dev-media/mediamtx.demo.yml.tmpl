# MediaMTX 설정 템플릿 — 멘토 데모용 임시 서버 전용 (기한부: 2026-08-24 만료, README.md 참조)
#
# 이 파일은 팀 공용 로컬 구성(infra/compose/mediamtx.yml)과 **다른 파일**이다. 수명이 다르므로 섞지 않는다.
# 플레이스홀더 2개(DEMO_PATH 자리 · SRT_PASSPHRASE 자리)는 render.sh 가 $DEMO_HOME/.env 값으로 치환한다.
# (여기에 실제 플레이스홀더 토큰을 문자 그대로 적지 않는다 — 적으면 렌더 시 함께 치환돼 이 주석에 시크릿이 박힌다.)
# 시크릿 원문은 이 저장소 어디에도 없다(ADR-018) — 렌더 결과물만 서버 로컬에 0640 으로 떨어진다.
#
# 값 근거: ADR-020(세그먼트 4s · part 500ms · DVR 1h=900개) / 결정 2·3(README.md → ADR-040)

# 인제스트 — SRT 하나만 연다
srt: yes
srtAddress: :8890

# 미사용 프로토콜 (노출면 축소)
rtmp: no
rtsp: no
webrtc: no
moq: no

# 관리 서버 4종 — 전부 미활성. compose.yml 에서 포트도 publish 하지 않는다(이중 차단).
api: no
metrics: no
pprof: no
playback: no

# LL-HLS 재생 + DVR 1시간
hls: yes
hlsAddress: :8888
hlsVariant: lowLatency
hlsSegmentDuration: 4s
hlsPartDuration: 500ms
hlsSegmentCount: 900 # DVR 1h = 4s x 900
hlsDirectory: /dvr # 비우면 세그먼트 900개가 전부 RAM 상주 → t3.small OOM
hlsAlwaysRemux: yes # 시청자 0명이어도 송출 시점부터 DVR 축적. 없으면 데모 전 선송출분이 통째로 버려진다
hlsAllowOrigins: ["*"] # 재생은 nginx 와 같은 오리진(8888)에서만 오므로 좁혀도 무손실이지만,
                       # 내장 hls.js 는 단순 GET(프리플라이트 없음)이라 이 값이 접근을 좌우하지 않는다. 기본값 명시.
# hlsCDNSecret: 설정하지 않는다 — 인증을 우회하는 별도 경로가 열린다

# 인증 — 기본 authInternalUsers 2항목을 이 단일 항목으로 **전체 대체**한다.
#  · 기본 첫 항목(user: any / 전 경로 무권한)을 남기면 "하나라도 통과=성공" 매칭이라 fail-open 이 된다.
#  · 기본 둘째 항목(localhost 한정 api/metrics/pprof)도 남기지 않는다 — 그 포트를 하나도 켜지 않아 지킬 대상이 없다.
#    (관리 포트를 켤 때는 둘째 항목을 유지해야 한다. 이 구성은 켜지 않으므로 제거가 맞다.)
#  · ips 필터는 쓰지 않는다 — 재생 요청은 nginx 프록시를 거쳐 오므로 클라이언트 IP가 컨테이너 IP로 보인다.
#    IP 제어는 SG(팀 IP/32) 한 곳으로 일원화한다(결정 2).
authInternalUsers:
  - user: any
    permissions:
      - action: publish # 빠뜨리면 OBS 가 붙지 않는다 (리허설 첫 실패 후보 1순위)
        path: __DEMO_PATH__
      - action: read
        path: __DEMO_PATH__

pathDefaults:
  srtPublishPassphrase: __SRT_PASSPHRASE__ # source: publisher 일 때만 적용된다 (publish 전용 — srtReadPassphrase 는 두지 않는다)
  overridePublisher: no # passphrase 를 아는 둘째 SRT 가 송출을 탈취하고 DVR 을 0부터 리셋하는 것을 막는다(데모 최대 실패모드)
  record: no # 디스크 2배 + 이번 데모는 HLS DVR 만 쓴다(결정 3)

# 경로 허용 — all_others 를 두지 않는다. 랜덤 경로 1개 외의 모든 송출·재생이 거부된다.
# (설정 파일이 기본값을 전체 대체하므로 이 절이 없으면 전 송출이 "path not configured" 로 거부된다)
paths:
  __DEMO_PATH__:
