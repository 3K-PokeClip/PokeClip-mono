# dev-media 환경값. 실제 .env 는 이 저장소에 절대 커밋하지 않는다 — ADR-018.
#   로컬: infra/dev-media/local/.env   (.gitignore 대상)
#   EC2 : /opt/pokeclip-demo/.env      (root:root 0600 — 서버 명령은 전부 sudo 로 실행한다)
#
# 값 생성 (생성된 값 자체를 이 파일에 적지 않는다. 어디서 만들어 어떻게 넣는지는 RUNBOOK 의 값 주입 절):
#   STREAM_KEY_RESOLVE_URL=http://<dev EC2 사설 주소>:8082   # 사설 주소여야 한다 — 공인 주소면 auth 출발지 잠금에 걸려 403
#                                                            # RUNBOOK 3절의 R1 값 단언은 10/8 · 172.16/12 · 192.168/16 IPv4 만 받는다
#   STREAM_KEY_RESOLVE_TOKEN=$(openssl rand -hex 32)         # auth 의 resolve 전용 출입증 — dev auth 쪽 값과 같아야 한다
#   MTX_API_PASS=$(openssl rand -hex 32)                     # 응답기가 MediaMTX Control API 를 부를 때의 자격
# 경로 잠금값은 여기 없다 — render.sh 가 렌더마다 새로 만든다.
#
# DEMO_HOME 은 반드시 절대경로다. 상대경로면 compose bind 가 딴 곳을 가리키므로 render.sh 가 거부한다.
#   로컬: DEMO_HOME="$(pwd)/infra/dev-media/local"   ← 저장소 루트에서 실행해 절대경로로 산출
#   EC2 : DEMO_HOME=/opt/pokeclip-demo

DEMO_HOME=
STREAM_KEY_RESOLVE_URL=
STREAM_KEY_RESOLVE_TOKEN=
MTX_API_PASS=
