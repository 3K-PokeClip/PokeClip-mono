# cp .env.example .env.local — 로컬 기본값 그대로 기동 가능
# 서버 주소는 여기에만 둔다. 소스 코드에 하드코딩 금지 (env 참조만).

# 백엔드 프록시 대상 (next.config.ts rewrites — 값이 없으면 프록시 자체가 걸리지 않는다)
AUTH_API_URL=http://localhost:8082
CLIP_API_URL=http://localhost:8081

# 미디어 재생 (클라이언트에서 직접 fetch — NEXT_PUBLIC 필수)
# 스텁: 플레이어 개발용 정적 세그먼트 (docker compose의 media-stub)
NEXT_PUBLIC_MEDIA_STUB_URL=http://localhost:8080/live/stub/index.m3u8
# 진짜 LL-HLS: {base}/{streamId}/index.m3u8 — index.m3u8 요청에 302(세션 파라미터)가
# 올 수 있다. hls.js 기본 동작은 따라가므로 커스텀 fetch를 끼울 때만 주의.
NEXT_PUBLIC_MEDIA_LIVE_BASE_URL=http://localhost:8888
