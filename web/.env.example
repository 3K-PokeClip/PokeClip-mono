# cp .env.example .env.local — 로컬 기본값 그대로 기동 가능
# 서버 주소는 여기에만 둔다. 소스 코드에 하드코딩 금지 (env 참조만).

# 백엔드 프록시 대상 (next.config.ts rewrites — 값이 없으면 프록시 자체가 걸리지 않는다)
AUTH_API_URL=http://localhost:8082
CLIP_API_URL=http://localhost:8081

# 구글 OAuth (클라이언트에서 동의 URL 조립 — NEXT_PUBLIC 필수)
# 백엔드 GOOGLE_CLIENT_ID와 같은 값. redirect_uri는 {origin}/auth/callback으로 조립되므로
# 구글 콘솔과 백엔드 GOOGLE_REDIRECT_URI에 그 주소가 등록돼 있어야 한다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 랜딩(이용약관·개인정보 처리방침이 있는 곳) — 비우면 https://pokeclip.com (POK-269)
# 로컬에서 랜딩 시안을 띄워 링크를 따라가 볼 때만 준다:
#   python3 -m http.server 8765 --directory design/landing-prototype
# NEXT_PUBLIC_LANDING_URL=http://127.0.0.1:8765

# 미디어 재생 (클라이언트에서 직접 fetch — NEXT_PUBLIC 필수)
# 스텁: 플레이어 개발용 정적 세그먼트 (docker compose의 media-stub)
# 배포 빌드에서는 반드시 비운다 — NEXT_PUBLIC_*는 빌드 타임에 번들로 인라이닝돼
# 값이 남으면 실서비스 /broadcast/livenow가 localhost 스텁을 로드하려다 실패한다.
# (비워두면 /broadcast/livenow는 「영상 신호 없음」 자리를 그린다 — mediaSource.ts · GlassPlayer)
NEXT_PUBLIC_MEDIA_STUB_URL=http://localhost:8080/live/stub/index.m3u8
# 진짜 LL-HLS: {base}/{streamId}/index.m3u8 — index.m3u8 요청에 302(세션 파라미터)가
# 올 수 있다. hls.js 기본 동작은 따라가므로 커스텀 fetch를 끼울 때만 주의.
NEXT_PUBLIC_MEDIA_LIVE_BASE_URL=http://localhost:8888
# 녹화 재생 서버(MediaMTX playback) — 끝난 방송 다시보기·편집기 미리보기가 쓴다(POK-251).
# 비우면 다시보기·미리보기 영상이 없고, 편집 구간의 시각 기준점은 방송 시작 시각이 된다.
# 로컬은 gitignore된 docker-compose.override.yml로 켠다(:9996).
NEXT_PUBLIC_MEDIA_PLAYBACK_BASE_URL=
