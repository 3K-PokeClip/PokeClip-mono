# cp .env.example .env.local — 로컬 기본값 그대로 기동 가능
# 서버 주소는 여기에만 둔다. 소스 코드에 하드코딩 금지 (env 참조만).

# 백엔드 프록시 대상 (next.config.ts rewrites — 값이 없으면 프록시 자체가 걸리지 않는다)
AUTH_API_URL=http://localhost:8082
CLIP_API_URL=http://localhost:8081

# 구글 OAuth (클라이언트에서 동의 URL 조립 — NEXT_PUBLIC 필수)
# 백엔드 GOOGLE_CLIENT_ID와 같은 값. redirect_uri는 {origin}/auth/callback으로 조립되므로
# 구글 콘솔과 백엔드 GOOGLE_REDIRECT_URI에 그 주소가 등록돼 있어야 한다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 랜딩(이용약관·개인정보 처리방침이 있는 곳) — 비우면 https://pokeclip.com (POK-269)
# 로컬에서 랜딩 시안을 띄워 링크를 따라가 볼 때만 준다:
#   python3 -m http.server 8765 --directory landing
# NEXT_PUBLIC_LANDING_URL=http://127.0.0.1:8765

# 사용 통계(PostHog, POK-356) — 둘 중 하나라도 비면 SDK를 불러오지 않는다. 로컬·CI·dev는 비워 둔다.
# 실측할 때만 넣고, PostHog 화면에서는 $host로 걸러 본다(운영과 한 프로젝트). 규칙은 docs/ANALYTICS.md
# NEXT_PUBLIC_*는 빌드 때 굳는다 — 운영 값을 바꾸면 다시 빌드한다.
# 운영 값(공개 키, landing/analytics.js와 같은 프로젝트·US 지역):
# NEXT_PUBLIC_POSTHOG_KEY=phc_pvpFknL2AmFADNjtTQ8ftB7dCabfsmVGczkvJZbpLkfw
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# 세션 녹화(POK-358) — 정확히 on일 때만 켠다. 콘솔 「Record user sessions」도 켜져 있어야 녹화가 시작된다
# NEXT_PUBLIC_POSTHOG_REPLAY=on
NEXT_PUBLIC_POSTHOG_REPLAY=

# 미디어 재생 (클라이언트에서 직접 fetch — NEXT_PUBLIC 필수)
# 스텁: 플레이어 개발용 정적 세그먼트 (docker compose의 media-stub)
# 배포 빌드에서는 반드시 비운다 — NEXT_PUBLIC_*는 빌드 타임에 번들로 인라이닝돼
# 값이 남으면 실서비스 /broadcast/livenow가 localhost 스텁을 로드하려다 실패한다.
# (비워두면 /broadcast/livenow는 「영상 신호 없음」 자리를 그린다 — mediaSource.ts · GlassPlayer)
NEXT_PUBLIC_MEDIA_STUB_URL=http://localhost:8080/live/stub/index.m3u8
# 진짜 LL-HLS: {base}/{streamId}/index.m3u8 — index.m3u8 요청에 302(세션 파라미터)가
# 올 수 있다. hls.js 기본 동작은 따라가므로 커스텀 fetch를 끼울 때만 주의.
NEXT_PUBLIC_MEDIA_LIVE_BASE_URL=http://localhost:8888
# 출입증 요청 스위치(POK-317). 웹은 이 값을 주소로 쓰지 않고 비었는지만 본다(playbackConfigured()):
# 비면 편집기가 영상 출입증을 받지 않고 ③ 되감기 목록 · 창 조각을 쿠키 없이 묻는다(CDN 뒤 prod 면 403).
# 지난 방송 채팅도 이 값을 본다: 있으면 다시보기 판정과 무관하게 확인 중 기다림(CHAT_WAIT_MS)까지 재생 위치를 기다린다(LiveScreen).
# 값은 출입증 쿠키 경로 기준이다: prod 는 clip MEDIA_BASE_URL 과 같은 영상 도메인(web README 「컨테이너 이미지」 절).
# 로컬은 비워도 된다(로컬 clip 은 출입증을 내주지 않는 것이 기본 — 출입증 흐름을 시험할 때만 그 MEDIA_BASE_URL 값).
NEXT_PUBLIC_MEDIA_PLAYBACK_BASE_URL=
# 되감기 제어면 주소(빌드 때 굳는다, POK-200). 웹이 {이 값}/api/streams/{id}/rewind 와 회차별 경로
# {이 값}/api/streams/{id}/rounds/{방송 번호}/rewind 를 붙여 묻는다. 끝에 / 를 붙이지 않는다.
# 비우면 되감기 세션을 열지 않는다(라이브 창 안 시크만). 끝난 뒤 들어온 화면의 회차 다시보기도 서지 않고 플레이어 기본 말을
# 띄운다(녹화로 대체하지 않는다 — 재생 서버 주소만 있고 이 값을 비운 로컬 차림에서 그 화면은 영상이 없다, POK-546).
# 지난 방송 목록의 다시보기 표지도 이 회차 경로로 묻는다(POK-568) — 비우면 끝난 방송 줄은 「VOD 준비 중」에 머문다.
# prod 값은 https://media.pokeclip.com 이다(web README 「컨테이너 이미지」 절).
#   로컬 MinIO 형상(infra/compose/rewind-minio 덧붙임): NEXT_PUBLIC_MEDIA_CONTROL_BASE_URL=http://localhost:8086
#   그 형상의 라이브는 위 기본값(http://localhost:8888) 그대로이고, 되감기 목록 · 조각은 로컬 엣지(127.0.0.1:28480)에서 받는다.
#   전용 실험 프로젝트(pcbench-<ID> · bench.example.yml 덧붙임)는 팀 포트를 피해 제어면 28086 · LL-HLS 28888 로 옮긴다.
NEXT_PUBLIC_MEDIA_CONTROL_BASE_URL=
