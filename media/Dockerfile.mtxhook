# MediaMTX 이미지 + 훅 기록 바이너리 한 층 (ADR-027 / POK-74)
#
# 왜 공식 이미지를 그대로 쓰지 않는가: 훅은 MediaMTX 컨테이너 **안에서** 실행되는 명령인데
# 표준 이미지는 scratch 라 셸도 curl 도 없다(실측). 훅이 부를 수 있는 것은 컨테이너 안에
# 놓인 정적 바이너리뿐이라, 공식 이미지 위에 mtxhookwrite 를 COPY 한 층만 얹는다.
# 서버 자체는 손대지 않으며 ENTRYPOINT 도 베이스 것을 그대로 물려받는다.
#
# **버전 고정의 유일한 집이 아래 FROM 이다.** compose 의 image: 가 build: 로 바뀌면서
# pin 위치가 여기로 옮겨왔다 — 버전을 올릴 때는 이 줄만 고치고, media/README.md 의
# "MediaMTX 버전업 체크리스트"를 따른다.

# 빌드 스테이지의 Go 버전은 media/go.mod 의 go 지시자와 같은 1.26 으로 유지한다.
FROM golang:1.26-alpine AS build
WORKDIR /src

# 의존만 먼저 받아 두면 소스만 바뀐 재빌드가 빨라진다.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CGO_ENABLED=0 = 순수 정적 바이너리. 최종 베이스가 scratch 파생이라 동적 링커가 없으므로
# 정적이 아니면 훅이 실행조차 되지 않는다(그리고 그 실패는 무징후다).
RUN CGO_ENABLED=0 go build -trimpath -o /out/mtxhookwrite ./cmd/mtxhookwrite

# 볼륨 소유권을 이미지에 심는 자리 (POK-79). moby 는 named volume 이 **비어 있을 때만**
# 이미지의 같은 경로에서 소유권·모드를 복사한다. 이미지에 그 경로가 없으면 populateVolume 이
# 조용히 건너뛰고 볼륨은 0755 root:root 로 남는다 = 비root 쓰기 불가.
# 그래서 빈 디렉토리를 만들어 최종 이미지에 넣는다. 내용은 없고 소유권만 나른다.
#
# 베이스가 alpine:3 인 이유: 필요한 것은 mkdir 하나뿐이고, golang 을 쓰면 Go 버전 pin 이
# 이 파일 안에서 2곳이 되어 드리프트 축이 하나 는다. alpine:3 은 media/Dockerfile 이
# 이미 쓰는 이미지라 추가 pull 이 없다.
#
# 이 장치는 **한시적**이다 — K8s 로 가면 파드 레벨 fsGroup 이 같은 일을 하므로 이 스테이지와
# 아래 COPY 3줄을 지운다. 폐기 절차와 판정 체크리스트는 docs/decisions 의
# "media 비특권 전환" ADR 의 K8s 절에 있다. USER 는 그때도 남긴다.
FROM alpine:3 AS prep
RUN mkdir -p /prep/recordings /prep/dvr /prep/hooks

# 태그 pin을 쓴다. digest pin(멀티아키 index digest는 아키텍처와 무관한 단일 값이라
# 어느 플랫폼에서든 그대로 쓸 수 있다)은 같은 태그를 다시 밀어 올리는 업스트림 재푸시까지
# 막아 주지만, 아직 로컬 dev 단계라 태그 추적의 편의를 택했다.
# 필요하면 `docker buildx imagetools inspect bluenviron/mediamtx:1.19.3` 로 index digest를
# 확인해 `FROM bluenviron/mediamtx:1.19.3@sha256:...` 형태로 바꾼다.
FROM bluenviron/mediamtx:1.19.3

# /hooks-bin 은 바이너리 자리, /hooks 는 스풀 볼륨 자리다. 둘을 섞지 않는다 —
# 같은 디렉토리에 두면 볼륨 마운트가 바이너리를 가린다.
#
# --chown=0:0 은 **런타임 계정이 자기 훅 바이너리를 덮어쓰지 못하게 root 소유로 못박는 것**이다.
# 생략하면 안 된다: COPY --from 은 빌드 컨텍스트에서 복사할 때와 달리 **소스 스테이지의 uid 를
# 보존한다**(실측: 10002 로 만든 파일은 10002 인 채로 넘어온다). 그래서 위 build 스테이지에
# USER 를 넣는 선의의 변경 하나로 이 바이너리가 10002 소유가 되고, 실행 계정이 그것을
# 덮어쓸 수 있게 된다. 그 불가능성이 이 비특권 전환의 가장 큰 실질 이득이자
# ADR-0003 결정 7(read_only 를 넣지 않는 근거)의 전제다.
COPY --chown=0:0 --from=build /out/mtxhookwrite /hooks-bin/mtxhookwrite

# --chown 은 **숫자만** 쓴다. 이 이미지에는 /etc/passwd 가 없어 이름을 해석할 수단이 없다.
COPY --chown=10002:10002 --from=prep /prep/recordings /recordings
COPY --chown=10002:10002 --from=prep /prep/dvr /dvr
COPY --chown=10002:10002 --from=prep /prep/hooks /hooks
USER 10002:10002
