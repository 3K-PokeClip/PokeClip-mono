# ingest-auth 응답기 — 멀티스테이지 빌드 (설계 2-6 · 2-8)
# 빌드 스테이지의 Go 버전은 media/go.mod 의 go 지시자와 같은 1.27 로 유지한다.
# 패치 판까지 고정한다 — 떠다니는 1.27 태그는 빌드 기계에 캐시된 옛 패치 판으로 빌드된다.
# 1.27.3 = GO-2026-6809(crypto/x509) 수정판. 올릴 때는 셋(Dockerfile · .ingest-auth · .mtxhook)을 함께 고친다.

FROM golang:1.27.3-alpine AS build
WORKDIR /src

# 의존만 먼저 받아 두면 소스만 바뀐 재빌드가 빨라진다.
COPY go.mod go.sum ./
RUN go mod download

COPY . .
# CGO_ENABLED=0 = 순수 정적 바이너리. 빌드 이미지의 libc 에 묶이지 않는다.
RUN CGO_ENABLED=0 go build -trimpath -o /out/ingest-auth ./cmd/ingest-auth

# 최종 스테이지는 셸이 없는 scratch 다 — 실행 파일 하나와 인증서 묶음 하나뿐이다. Control API 자격(환경 변수) 옆에 셸 ·
# wget · nc 를 두지 않는다. 운영 확인(거부 목록을 UID 10003 이 읽는가, 기록 디렉터리에 쓸 수 있는가)은
# `/ingest-auth healthcheck` 가 한다. 셸이 없다 — 디버그는 별도 컨테이너로 한다.
FROM scratch

# 4C 를 https 로 부를 때를 대비한 신뢰 묶음이다 — Go 가 처음 찾는 자리(crypto/x509 root_linux.go)에 둔다. 실행 계정이
# 바꾸지 못하게 root 소유로 못박는다.
COPY --chown=0:0 --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

# 바이너리 자리는 /ingest-auth 다. compose healthcheck(["CMD", "/ingest-auth", "healthcheck"])와 RUNBOOK 의 cut
# (docker compose exec ingest-auth /ingest-auth cut <토큰>)이 이 경로를 부른다(설계 2-8 · 3-4) — 셸이 없어 exec 꼴만
# 된다.
# --chown=0:0 은 실행 계정이 바이너리를 덮어쓰지 못하게 root 소유로 못박는다 — COPY --from 은 빌드 스테이지의 uid 를
# 그대로 옮기므로(Dockerfile.mtxhook 의 실측), 빌드 스테이지에 USER 를 더하는 변경 하나로 소유가 바뀌지 않게 한다.
COPY --chown=0:0 --from=build /out/ingest-auth /ingest-auth

# 비특권 UID 10003 으로 돌린다(설계 2-8). compose 는 user 를 적지 않는다 — 이 USER 가 정본 · start-media INGEST_AUTH_UID
# 기본값과 같다(render_test 사례 45). 숫자로 적는다 — scratch 에는 /etc/passwd 가 없다.
# 거부 목록(/etc/ingest-auth)과 허용 연결 기록(/var/lib/ingest-auth)은 compose 가 호스트 디렉터리로 붙인다 —
# 이미지에 두지 않는다.
USER 10003:10003

ENTRYPOINT ["/ingest-auth"]
