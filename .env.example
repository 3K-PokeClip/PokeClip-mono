# cp .env.example .env 후 값 수정 (로컬 개발 전용 — .env는 커밋 금지)
POSTGRES_USER=pokeclip
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=pokeclip

# ── auth·clip 공용 ──────────────────────────────────────────────────
# 두 서버가 같은 값을 읽는다. auth가 서명하고 clip이 검증한다(ADR-048) —
# 값이 갈리면 서버는 뜨는데 사람 API만 전부 401이 된다.
# 만드는 법: openssl rand -base64 48
JWT_SECRET=
INTERNAL_API_TOKEN=

# ── clip·chat-collector가 auth를 부를 때 ────────────────────────────
# auth의 내부 창구 주소. auth 자신은 이 값을 안 쓴다 — 그래서 위 절이 아니다.
# 🔴 clip은 이 값이 비면 부팅을 거부한다(POK-117). 시크릿이 아니라 주소이므로
# 로컬 bootRun용 실값을 그대로 적어 둔다 — 비워 두면 처음 띄우는 사람이 원인 없이 막힌다.
# compose 안에서는 서비스 이름이다(docker-compose.dev.yml이 http://auth:8082로 덮는다).
AUTH_BASE_URL=http://localhost:8082
