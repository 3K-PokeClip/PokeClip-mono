# cp .env.example .env 후 값 수정 (로컬 개발 전용 — .env는 커밋 금지)
POSTGRES_USER=pokeclip
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=pokeclip

# ── auth·clip 공용 ──────────────────────────────────────────────────
# 두 서버가 같은 값을 읽는다. auth가 서명하고 clip이 검증한다(ADR-047) —
# 값이 갈리면 서버는 뜨는데 사람 API만 전부 401이 된다.
# 만드는 법: openssl rand -base64 48
JWT_SECRET=
INTERNAL_API_TOKEN=
