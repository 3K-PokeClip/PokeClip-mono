# dev.pokeclip.com 배포용 환경변수 예시.
#
#   cp .env.dev.example .env
#
# 실제 값이 담긴 .env 는 저장소 루트 .gitignore 가 막는다. 이 저장소는 public 이라
# 한 번 올라간 키는 지워도 히스토리에 남는다 — 이 파일에 진짜 값을 적지 않는다.

# ── DB (auth·clip·chat-collector 공용) ──────────────────────────────
# compose 안의 postgres 컨테이너가 이 값으로 뜨고, 서버 셋이 같은 값으로 붙는다.
POSTGRES_USER=pokeclip
POSTGRES_PASSWORD=
POSTGRES_DB=pokeclip

# ── auth 필수 아홉 (JWT_SECRET·INTERNAL_API_TOKEN은 clip도 같은 값을 읽는다) ──
# 하나라도 비면 auth 가 부팅에서 죽는다. 죽는 편이 낫다 —
# 빈 값으로 뜨면 서버는 살아 있고 헬스체크도 통과하는데 그 기능만 전부 실패한다.
#
# 아래 셋은 아무 난수여도 된다. 만드는 법:
#   JWT_SECRET·INTERNAL_API_TOKEN   openssl rand -base64 48
#   SECRET_STORE_KEY                openssl rand -base64 32   (AES-256 = 32바이트 고정)
JWT_SECRET=
SECRET_STORE_KEY=
# ⚠ auth 만 쓰는 값이 아니다 — chat-collector 도 같은 값을 받는다(compose 가 둘 다에 넘긴다).
# 그쪽에서는 /internal/* 창구의 자물쇠이자 auth 에 열쇠를 물을 때 내미는 표다.
# 비면 창구가 스스로 잠겨 올바른 토큰으로도 401 이다.
INTERNAL_API_TOKEN=

# 브라우저가 이 API를 부를 수 있는 출처. 와일드카드(*)를 넣으면 부팅이 거부된다.
# 사이트가 https 라 출처도 https 다(POK-315). 다른 출처에서 이 API를 직접 부를 때 이 값과 맞춰 본다.
CORS_ALLOWED_ORIGINS=https://dev.pokeclip.com

# 구글·치지직 개발자 콘솔에서 발급받은 값. 치지직은 redirect-uri 가 앱당 하나만 등록되므로
# 로컬용 앱과 dev 용 앱이 다르다(2026-08-17 확인). 구글(GCP)은 한 앱에 여러 개를 등록할 수 있다(아래 유튜브 주석).
#
# 🔴 아래 리다이렉트 셋은 https 다(POK-315). 예시만 먼저 바꿨다. 각 OAuth 콘솔(구글 · 치지직 · 유튜브)에
# https 리다이렉트를 등록한 **뒤에** dev .env 를 바꾼다. .env 만 먼저 바꾸면 공급자가 「등록되지 않은
# 리다이렉트」로 동의를 거부해 로그인 · 채널 연동이 깨진다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dev.pokeclip.com/auth/callback
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
# ⚠ 목표값이다. 개발자 센터 dev 앱은 아직 /auth/chzzk/callback으로 등록돼 있다(POK-205 기록).
# 재등록 전에 이 값으로 띄우면 치지직이 redirect URI 불일치로 동의를 거부한다. https 재등록(POK-315)과 한 번에 한다.
CHZZK_REDIRECT_URI=https://dev.pokeclip.com/oauth/chzzk/callback
# 유튜브 업로드용 GCP 앱(POK-121). 로그인용 구글 앱(GOOGLE_*)과 **다른 앱**이다 —
# 업로드 권한은 프로젝트 단위 심사 대상이라 폭발 반경을 나눴다. 셋 다 없으면 auth 부팅이 죽는다.
# redirect-uri 는 GCP 콘솔에 여러 개 등록할 수 있어 치지직과 달리 환경마다 앱을 나눌 필요는 없다.
#
# 🔴 https 다 — 구글은 비-localhost 리디렉션에 http 를 거부한다(localhost·127.0.0.1 만 예외).
#   위 GOOGLE_REDIRECT_URI 도 같은 제약이라 https 로 바꿨다(POK-315). 콘솔 등록 뒤 .env 를 바꾸는 순서는 위와 같다.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://dev.pokeclip.com/oauth/youtube/callback

# ── 선택 (비워 두면 그 기능만 꺼진 채 서버는 정상 기동) ──────────────
AWS_REGION=ap-northeast-2

# auth 의 스트림키 암호 저장소(POK-272, ADR-018). 이행 순서는 services/README.md 「스트림키 암호 이행」.
# 읽기·쓰기 저장소. postgres | aws. 이행 실행기(sync)가 끝난 뒤에 aws 로 바꾼다.
STREAM_KEY_SECRET_STORE_TYPE=postgres
# 재발급·탈퇴 때 옛 암호를 지울 곳(쉼표 목록). 병행 기간에는 두 저장소 다 지운다. 병행 종료 PR 뒤 aws.
STREAM_KEY_SECRET_RETIRE_FROM=postgres,aws
# 비밀 이름 접두. 비우면 compose 가 보간에서 멈춰 auth·clip 배포가 둘 다 안 된다. IAM 정책의 접두와 같아야 한다.
STREAM_KEY_SECRET_REF_PREFIX=pokeclip/dev/stream-key/

# auth 의 resolve 전용 출입증(계약4 4C) — media-dev 가 스트림키를 물을 때 내미는 표와 그 출발지. 비워 두면 그 창구만
# 닫히고(늘 401) auth 는 정상으로 뜬다. 토큰을 채우면 대역도 채워야 하고,
# 아래 FORWARD_HEADERS_STRATEGY 가 none 이어야 auth 가 부팅한다.
# 만드는 법:
#   STREAM_KEY_RESOLVE_TOKEN          openssl rand -hex 32   (INTERNAL_API_TOKEN 과 다른 값이어야 한다)
#   STREAM_KEY_RESOLVE_ALLOWED_CIDRS  media-dev 의 사설 IPv4 주소에 /32 를 붙인 것 하나
STREAM_KEY_RESOLVE_TOKEN=
STREAM_KEY_RESOLVE_ALLOWED_CIDRS=

# auth 의 프로필 사진(POK-207). 비면 사진 기능만 꺼진다 — 이름 수정·로그인은 그대로 돈다.
# chat-collector 의 S3_BUCKET 과 다른 창고를 가리킬 수 있게 이름을 나눴다.
PROFILE_PHOTO_S3_BUCKET=
# 비면 진짜 AWS. LocalStack·MinIO 를 쓸 때만 채운다(그때만 아래 path-style 도 true 로).
PROFILE_PHOTO_S3_ENDPOINT=
PROFILE_PHOTO_S3_FORCE_PATH_STYLE=false
# 창고 이름을 채웠다면 아래 둘도 채운다 — 안 채우면 auth 가 부팅에서 죽는다(사진을 올릴 수는
# 있는데 볼 수가 없는 상태를 막는다). 서명키는 JWT_SECRET 과 다른 값으로 만든다:
#   openssl rand -base64 48
PROFILE_PHOTO_TOKEN_SECRET=
# 사진 주소의 앞부분. 사이트와 같은 https 주소를 쓴다. 웹 리라이트(web/next.config.ts 의
# /api/profile-photos)가 auth 로 넘긴다. 바깥 8082 는 닫으므로(POK-293 M12) 포트를 붙이지 않는다.
# https 화면에서 http 사진을 부르면 브라우저가 막는다(혼합 콘텐츠).
# 🔴 dev 상자의 웹이 그 리라이트를 가진 판이어야 한다. 옛 사본(web-demo)에는 없어 https 주소의
# /api/profile-photos 가 웹 404 다(2026-10-16 실측). nginx 에서 그 경로를 auth 로 넘기거나
# 웹을 다시 배포한 뒤에 이 값을 바꾼다.
#
# 🔴 아래 AUTH_BASE_URL 과 이름이 비슷한데 뜻이 반대다. 이것은 브라우저가 보고 붙는 주소이고,
# 저것은 서버(chat-collector·clip)가 컨테이너 네트워크 안에서 붙는 주소(http://auth:8082)다.
# 여기에 http://auth:8082 를 적으면 브라우저에게는 없는 호스트라 사진만 안 나온다.
#
# 틀려도 아무 데서도 에러가 안 난다 — 로그인도 이름 수정도 정상이고 사진만 조용히 안 보인다.
PROFILE_PHOTO_BASE_URL=https://dev.pokeclip.com

# auth 가 X-Forwarded-For 를 믿을지(POK-91). dev 는 프록시가 없어 none. 로드밸런서 뒤로 갈 때 native.
# 위 resolve 전용 토큰(STREAM_KEY_RESOLVE_TOKEN)이 있으면 native 로 바꿀 수 없다(부팅 검사) —
# 토큰부터 비우거나 media-dev 쪽과 먼저 맞춘다(토큰을 비우면 전용 창구가 닫혀 media-dev 응답기의 새 송출이 모두 거부된다).
# native 면 사설망·루프백에서 온 요청의 헤더만 믿는다. 밖에서 직접 온 요청의 헤더는 무시된다.
# 비우지 말 것. 빈 값은 none 이 아니라 「미설정」이라 Boot 가 플랫폼을 보고 정한다(운영 ECS 는 자동 native).
FORWARD_HEADERS_STRATEGY=none

# clip 의 SQS 방송 이벤트 수신. true 로 켜면 BROADCAST_QUEUE_URL 이 필수가 된다.
BROADCAST_INTAKE_ENABLED=false
BROADCAST_QUEUE_URL=

# clip 의 놓친 방송 치우기(POK-244). 종료 편지를 못 받은 방송을 마지막 조각 뒤 GRACE 가 지나면 ended 로 굳힌다.
# 기본 꺼짐. GRACE 는 20분 미만이면 부팅이 거부한다(편지는 마지막 조각 뒤 정산 창 15분 + 전달이 지나야 온다).
# 🔴 media 없이 clip 만 띄우는 자리에서는 켜지 마라 — 장부 표(stream_segments)가 없으면 부팅이 거부된다.
BROADCAST_REAPER_ENABLED=false
BROADCAST_REAPER_INTERVAL=PT1M
BROADCAST_REAPER_GRACE=PT30M

# chat-collector 의 같은 것. 🔴 큐가 둘이라 변수도 둘이다 — 방송 편지는 팬아웃이고
# (clip·chat-collector 가 같은 편지를 각자 받는다) SQS 는 한 편지를 한 소비자에게만 주므로,
# 위 두 값을 그대로 나눠 쓰면 두 서버가 편지를 서로 뺏는다. 컨테이너 안에서 읽는 이름은
# 양쪽 다 BROADCAST_* 그대로이고, 가르는 것은 호스트 쪽 이름뿐이다(docker-compose.dev.yml).
# 꺼져 있으면 chat-collector 가 방송 편지를 한 통도 안 먹어, 수집 상태 창구가 열려 있어도
# 모든 방송에 unknown 을 답한다.
CHAT_BROADCAST_INTAKE_ENABLED=false
CHAT_BROADCAST_QUEUE_URL=

# chat-collector 가 스트리머별 치지직 열쇠를 물으러 갈 auth 주소.
# compose 안에서는 서비스 이름이 곧 호스트 이름이라 기본값이 http://auth:8082 다.
# 비워 두면 그 기본값을 쓴다 — compose 밖에서 띄울 때만 채운다.
AUTH_BASE_URL=

# auth 가 탈퇴 정리 알림(POK-256)을 보낼 clip·chat-collector 주소. 기본값이 compose 안 주소(http://clip:8081 ·
# http://chat-collector:8083)라 비워 두면 그것을 쓴다 — compose 밖에서 띄울 때만 채운다.
CLIP_BASE_URL=
COLLECTOR_BASE_URL=

# chat-collector 의 치지직 채팅 수집. 켜면 실제 세션을 잡아 연결 상한 3개를 먹는다.
CHZZK_ENABLED=false
CHZZK_ACCESS_TOKEN=

# chat-collector 의 채팅 원본 S3 아카이브. 비면 아카이브만 꺼진다.
S3_BUCKET=

# chat-collector 의 떼기(POK-244). clip 명부에 없는 붙은 방송의 세션을 반납한다. clip 의 BROADCAST_REAPER_* 와 같이 켠다.
CHAT_DETACH_ENABLED=false
CHAT_DETACH_GRACE=PT10M

# chat-collector 의 재부착(POK-219). 켜면 clip 의 「방송 중 목록」을 주기적으로 물어 놓친 방송에 다시 붙는다.
# 🔴 CHAT_BROADCAST_INTAKE_ENABLED 가 꺼진 채 이것만 켜면 부팅이 거부된다.
CHAT_REATTACH_ENABLED=false

# chat-collector 의 채팅 중계(POK-234). 켜면 받은 채팅 · 후원을 clip 에 바로 민다(라이브 화면).
CHAT_RELAY_ENABLED=false
# 중계가 막혔을 때 들고 있는 채팅 수 상한.
CHAT_RELAY_BUFFER_MAX=10000

# chat-collector 의 방송 정보(제목 · 카테고리 · 시청자 수) 수집(POK-234). 켜면 CHZZK_CLIENT_ID · CHZZK_CLIENT_SECRET 이 필요하다.
BROADCAST_INFO_ENABLED=false
BROADCAST_INFO_INTERVAL=PT1M

# clip 의 영상 출입증(POK-122) — CloudFront 서명 쿠키. 셋이 다 비면 출입증 문만 503 이고 카드·채팅은
# 그대로 돈다. 일부만 채우면 clip 이 부팅을 거부한다(「일부러 안 켬」과 「깜빡함」을 가른다).
# CLOUDFRONT_KEY_PAIR_ID 는 CloudFront 에 공개키를 등록하면 받는 K… 값(1번).
# CLOUDFRONT_PRIVATE_KEY_PEM 은 그 공개키의 짝인 PKCS#8 PEM 본문 — 한 줄로 넣으면 리터럴 \n 을 개행으로 읽는다.
#   만드는 법: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private_key.pem
#   PKCS#1(BEGIN RSA PRIVATE KEY)이면: openssl pkcs8 -topk8 -nocrypt -in private_key.pem
# 🔴 비밀키다. 이 파일에도, 채팅에도, 커밋에도 적지 않는다.
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PEM=
# 영상이 나가는 CDN 주소(끝 / 없음). 정책 범위는 종류마다 {이 값}/{kind}/{streamId}/* 다(앞 와일드카드 금지).
MEDIA_BASE_URL=
# 출입증 쿠키의 Domain. 앱·clip API·미디어가 전부 이 아래여야 붙는다. 비면 호스트 전용(로컬).
PLAYBACK_COOKIE_DOMAIN=.pokeclip.com
# 출입증 수명(ISO-8601).
PLAYBACK_ACCESS_TTL=PT60M

# clip 의 영상 만들기 주문(POK-125). 켜면 편집본에서 「만들어 줘」가 주문줄(SQS)에 실린다. 넷 다 비면 부팅이 거부된다.
# 큐 둘은 계약1 1절 jobs-render + 전용 DLQ(2026-09-15 만든 실물: pokeclip-jobs-render · pokeclip-jobs-render-dlq).
# 창고 둘 — CLIPS_BUCKET 은 완성 영상(60일 만료), SEGMENT_BUCKET 은 1번 조각 창고(읽기만).
# 자격증명은 안 적는다 — dev EC2 는 인스턴스 역할로 큐·창고에 붙는다.
RENDER_ENABLED=false
RENDER_QUEUE_URL=
RENDER_DLQ_URL=
CLIPS_BUCKET=
SEGMENT_BUCKET=

# clip 의 유튜브 업로드 주문(POK-220). 켜면 보관함의 「업로드」가 업로드 줄(SQS)에 실린다. 줄 둘과 CLIPS_BUCKET 이 필수다.
# 실물(2026-09-26): pokeclip-jobs-upload(숨김 900초) · pokeclip-jobs-upload-dlq. EC2 역할에 이 두 줄의 SQS 권한이 있어야 한다.
UPLOAD_ENABLED=false
UPLOAD_QUEUE_URL=
UPLOAD_DLQ_URL=
# 업로드 실패 큐를 훑는 주기(ISO-8601).
UPLOAD_RECONCILE_INTERVAL=PT1M

# clip 의 썸네일 주문(POK-277). 켜면 라이브 1분마다 · 지난 방송 · 카드 · 완성 영상의 사진 주문을 줄(SQS)에 싣는다.
# 켜면 THUMBNAIL_QUEUE_URL 이 필수다(jobs-thumbnail + 전용 DLQ, 1번이 dev 에 만든다). 사진 창고는 CLIPS_BUCKET 을 같이 쓴다.
# 꺼져 있으면 목록의 사진 주소가 전부 null 이다. 렌더 일꾼(workers/render)이 이 줄을 읽는다.
THUMBNAIL_ENABLED=false
THUMBNAIL_QUEUE_URL=
# 주문을 훑는 주기(ISO-8601). 라이브 사진이 이 간격으로 바뀐다.
THUMBNAIL_INTERVAL=PT1M
